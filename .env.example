# Base de données : Neon en recette/production (copier la chaîne de connexion « pooled », sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pilotage
MIGRATIONS_AU_DEMARRAGE=1
PORT=3000
# Origine(s) autorisée(s) du frontend, séparées par des virgules (ex. https://pilotage-web.vercel.app)
WEB_ORIGIN=http://localhost:4200
# Secrets JWT (chaînes aléatoires longues)
JWT_SECRET=a-changer
# Stockage des fichiers : Vercel Blob (vide = stockage disque local ./stockage en développement)
BLOB_READ_WRITE_TOKEN=
# Seed initial
ORGANISATION_CODE=principale
ORGANISATION_NOM=Organisation principale
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=
