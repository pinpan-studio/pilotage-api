# Base de données : Neon en recette/production (copier la chaîne de connexion « pooled », sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pilotage
MIGRATIONS_AU_DEMARRAGE=1
PORT=3000
# Origine(s) autorisée(s) du frontend, séparées par des virgules (ex. https://pilotage-web.vercel.app)
WEB_ORIGIN=http://localhost:4200
# Secrets JWT (chaînes aléatoires longues)
JWT_SECRET=a-changer
# Connexion Google : ID client OAuth (application Web) — public, aussi servi par GET /api/v1/config
GOOGLE_CLIENT_ID=
# 0 = désactiver la connexion par mot de passe dans l’interface (secours du super administrateur)
CONNEXION_MOT_DE_PASSE=1
# Stockage des fichiers : Vercel Blob, store PRIVÉ (vide = disque local ./stockage en développement)
# Test optionnel sur un vrai store : BLOB_READ_WRITE_TOKEN_TEST=… npm test
BLOB_READ_WRITE_TOKEN=
# Seed initial
ORGANISATION_CODE=principale
ORGANISATION_NOM=Organisation principale
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=
# 1 = importer le projet fictif exemple-declarations du kit v1
SEED_DEMO=0
