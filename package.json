{
  "name": "pilotage-api",
  "version": "0.1.0",
  "private": true,
  "description": "API, serveur MCP et journal de l'application Pilotage",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/db/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/db/migrations/Migration",
    "migration:run": "npm run typeorm -- migration:run",
    "seed": "ts-node src/db/seed/seed.ts",
    "test": "jest --runInBand",
    "openapi": "nest build && OPENAPI_SEULEMENT=1 JWT_SECRET=generation-openapi node dist/openapi.js"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/typeorm": "^11.0.3",
    "@vercel/blob": "^2.9.0",
    "adm-zip": "^0.6.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "diff": "^8.0.4",
    "docx": "^9.15.3",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "marked": "^15.0.12",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.10",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    },
    "glob": "^14.0.2",
    "minimatch": "^11.0.8"
  }
}
